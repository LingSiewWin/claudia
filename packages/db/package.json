{
  "name": "@authority/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts", "./testing": "./src/testing.ts" },
  "scripts": {
    "test": "vitest run",
    "test:pg": "PG_INTEGRATION=1 vitest run test/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@authority/core": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
